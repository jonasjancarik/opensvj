# Zkopírujte do .env. Hodnoty jsou pro lokální vývoj.
DATABASE_URL=postgresql+psycopg://svj:svj@localhost:5440/svj
TEST_DATABASE_URL=postgresql+psycopg://svj:svj@localhost:5440/svj_test
AUTH_DATABASE_URL=postgresql://svj:svj@localhost:5440/svj
# Adresa, na které uživatel aplikaci otevírá (Vite proxy předává /api dál).
APP_URL=http://localhost:5180
BETTER_AUTH_URL=http://localhost:5180
# Podepisuje přihlášení. Vygenerujte vlastní (openssl rand -base64 32); se vzorovou
# hodnotou se přihlašovací služba nespustí.
BETTER_AUTH_SECRET=change-me
# Kdo se smí přihlásit (čárkou oddělené e-maily). Ostatním se odkaz nepošle.
AUTH_ALLOWED_EMAILS=
# Kdo z nich smí jen nahlížet a nic neukládá (např. kontrolní komise nebo účetní).
AUTH_READONLY_EMAILS=
# Odesílání e-mailů (přihlašovací odkaz a dokumenty vlastníkům). Odesílací doména má mít
# platné SPF, DKIM a DMARC.
# SMTP_HOST=smtp.example.cz
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=starttls          # starttls | ssl | none
# SMTP_FROM=SVJ Ukázková 12 <vybor@example.cz>
# Pro vývoj: bez SMTP_HOST se e-maily jen uloží jako soubory .eml do této složky.
# MAIL_DIR=/tmp/opensvj-maily
# Bez nastavené pošty se přihlašovací odkaz vypíše do výstupu služby auth.
# Jen pro vývoj na vlastním počítači, na serveru nezapínat.
AUTH_LINKS_TO_CONSOLE=1
# Popis API na /api/docs, jen pro vývoj.
API_DOCS=true
# Profil SVJ: účty, jednotky a předpis. Výchozí je vymyšlené ukázkové SVJ ze složky
# profiles. Data skutečného SVJ se drží v samostatné soukromé složce (viz README), např.:
# PROFIL=pilot
# PROFILY=../opensvj-pilot/profiles
PROFIL=ukazka
JWKS_URL=http://localhost:3010/api/auth/jwks
JWT_ISSUER=http://localhost:5180
JWT_AUDIENCE=http://localhost:5180
