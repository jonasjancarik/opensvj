# Zkopírujte do .env. Hodnoty jsou pro lokální vývoj.
DATABASE_URL=postgresql+psycopg://svj:svj@localhost:5440/svj
TEST_DATABASE_URL=postgresql+psycopg://svj:svj@localhost:5440/svj_test
AUTH_DATABASE_URL=postgresql://svj:svj@localhost:5440/svj
# Adresa, na které uživatel aplikaci otevírá (Vite proxy předává /api dál).
APP_URL=http://localhost:5180
BETTER_AUTH_URL=http://localhost:5180
BETTER_AUTH_SECRET=change-me-dev-secret-at-least-32-characters
# Kdo se smí přihlásit (čárkou oddělené e-maily). Ostatním se odkaz nepošle.
AUTH_ALLOWED_EMAILS=
# Profil SVJ: účty, jednotky a předpis. Výchozí je vymyšlené ukázkové SVJ ze složky
# profiles. Data skutečného SVJ se drží v samostatné soukromé složce (viz README), např.:
# PROFIL=pilot
# PROFILY=../opensvj-pilot/profiles
PROFIL=ukazka
JWKS_URL=http://localhost:3010/api/auth/jwks
JWT_ISSUER=http://localhost:5180
JWT_AUDIENCE=http://localhost:5180
